<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wireless Earbuds - Cream & Ivory Edition</title>
    <style>
        :root {
            --bg-cream: #FFFDF9;
            --bg-cream-soft: #FDFBF7;
            --card-white: #FFFFFF;
            --border-cream: #F1ECE1;
            --text-dark: #1C1917;
            --text-muted: #78716C;
            --accent-warm: #D97706;
            --accent-gold: #B45309;
            --shadow-cream: 0 20px 40px rgba(180, 83, 9, 0.05);
            --shadow-hover: 0 30px 60px rgba(180, 83, 9, 0.12);
        }

        * {
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
            background-color: var(--bg-cream);
            color: var(--text-dark);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            animation: pageFadeIn 1s ease-out forwards;
        }

        /* Glassmorphic Warm Navigation */
        nav {
            background: rgba(255, 253, 249, 0.9);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            padding: 1.2rem 3rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
            border-bottom: 1px solid var(--border-cream);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
            animation: slideDownNav 0.8s ease-out;
        }

        .logo {
            color: var(--text-dark);
            font-weight: 900;
            font-size: 1.4rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .logo-dot {
            width: 10px;
            height: 10px;
            background: var(--accent-gold);
            border-radius: 50%;
            display: inline-block;
        }

        .nav-links {
            display: flex;
            gap: 2rem;
        }

        nav a {
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95rem;
            position: relative;
            padding: 0.3rem 0;
            transition: color 0.3s ease;
        }

        nav a::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0%;
            height: 2px;
            background: var(--accent-gold);
            transition: width 0.3s ease;
        }

        nav a:hover, nav a.active {
            color: var(--text-dark);
        }

        nav a:hover::after, nav a.active::after {
            width: 100%;
        }

        /* Hero Section */
        .hero {
            max-width: 1200px;
            margin: 3rem auto;
            padding: 2rem 1.5rem;
            text-align: center;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: var(--card-white);
            color: var(--accent-gold);
            padding: 0.5rem 1.4rem;
            border-radius: 50px;
            font-weight: 700;
            font-size: 0.85rem;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            border: 1px solid var(--border-cream);
            box-shadow: 0 4px 15px rgba(180, 83, 9, 0.06);
            margin-bottom: 1.5rem;
            animation: badgePulse 3s infinite ease-in-out;
        }

        .badge-dot {
            width: 8px;
            height: 8px;
            background-color: var(--accent-gold);
            border-radius: 50%;
            animation: ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
        }

        h1 {
            font-size: 3.8rem;
            margin: 0.5rem 0;
            color: var(--text-dark);
            letter-spacing: -1px;
            line-height: 1.1;
            animation: heroTextReveal 1s ease-out;
        }

        h2 {
            color: var(--text-muted);
            font-size: 1.4rem;
            font-weight: 400;
            margin-top: 0.5rem;
            animation: heroTextReveal 1.2s ease-out;
        }

        .intro-text {
            font-size: 1.15rem;
            line-height: 1.85;
            color: #57534E;
            max-width: 820px;
            margin: 2rem auto;
            animation: fadeIn 1.4s ease-out;
        }

        /* Showcase Image Wrapper */
        .product-image-container {
            position: relative;
            display: inline-block;
            margin: 3rem 0;
            perspective: 1000px;
        }

        .product-image-container::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 450px;
            height: 450px;
            background: radial-gradient(circle, rgba(245, 230, 211, 0.6) 0%, rgba(255, 253, 249, 0) 70%);
            filter: blur(50px);
            z-index: 0;
            animation: glowPulse 5s ease-in-out infinite alternate;
        }

        .product-image {
            position: relative;
            z-index: 1;
            width: 500px;
            max-width: 100%;
            border-radius: 28px;
            box-shadow: var(--shadow-cream);
            animation: float3D 6s ease-in-out infinite alternate;
            transition: transform 0.6s ease, box-shadow 0.6s ease;
            border: 1px solid var(--border-cream);
            background: #fff;
        }

        .product-image:hover {
            transform: scale(1.04) rotateY(6deg) rotateX(-4deg);
            box-shadow: var(--shadow-hover);
        }

        /* Floating Interactive Badges */
        .spec-floating-tag {
            position: absolute;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid var(--border-cream);
            padding: 0.7rem 1.3rem;
            border-radius: 50px;
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--text-dark);
            box-shadow: 0 10px 25px rgba(180, 83, 9, 0.08);
            z-index: 2;
            animation: tagFloat 4s ease-in-out infinite alternate;
            transition: all 0.3s ease;
        }

        .spec-floating-tag:hover {
            background: var(--accent-gold);
            color: #fff;
            transform: scale(1.1);
        }

        .tag-1 { top: 15%; left: -10%; animation-delay: 0s; }
        .tag-2 { bottom: 20%; right: -10%; animation-delay: 1.5s; }

        /* Price & Buy CTA Card */
        .price-card {
            background: var(--card-white);
            border: 1px solid var(--border-cream);
            display: inline-flex;
            flex-direction: column;
            align-items: center;
            padding: 2.5rem 4rem;
            border-radius: 28px;
            box-shadow: var(--shadow-cream);
            margin: 2rem 0;
            animation: cardPop 0.9s ease-out;
            position: relative;
            overflow: hidden;
        }

        .price-card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(45deg, transparent, rgba(253, 251, 247, 0.9), transparent);
            transform: rotate(45deg);
            animation: lightShine 5s infinite;
        }

        .price-label {
            font-size: 0.85rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 700;
        }

        .price-amount {
            font-size: 2.6rem;
            font-weight: 900;
            color: var(--text-dark);
            margin: 0.4rem 0 1.5rem 0;
            letter-spacing: -1px;
        }

        .btn-buy {
            background: var(--text-dark);
            color: #ffffff;
            border: 2px solid var(--text-dark);
            padding: 1.1rem 3.5rem;
            font-size: 1.1rem;
            font-weight: 800;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
            transition: all 0.4s ease;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .btn-buy:hover {
            background: var(--bg-cream-soft);
            color: var(--text-dark);
            border-color: var(--text-dark);
            transform: translateY(-4px) scale(1.04);
            box-shadow: 0 14px 35px rgba(0, 0, 0, 0.2);
        }

        /* Interactive Audio Preview Card */
        .audio-demo-card {
            background: var(--bg-cream-soft);
            border: 1px solid var(--border-cream);
            border-radius: 24px;
            padding: 2rem;
            max-width: 600px;
            margin: 3rem auto;
            display: flex;
            align-items: center;
            gap: 1.5rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.02);
        }

        .play-btn {
            width: 55px;
            height: 55px;
            background: var(--accent-gold);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            cursor: pointer;
            transition: transform 0.3s ease;
            box-shadow: 0 6px 18px rgba(180, 83, 9, 0.3);
        }

        .play-btn:hover {
            transform: scale(1.1);
        }

        .audio-info {
            text-align: left;
            flex-grow: 1;
        }

        .audio-info h4 {
            margin: 0;
            font-size: 1.1rem;
            color: var(--text-dark);
        }

        .audio-info p {
            margin: 0.2rem 0 0.5rem 0;
            font-size: 0.88rem;
            color: var(--text-muted);
        }

        .sound-wave {
            display: flex;
            align-items: center;
            gap: 4px;
            height: 20px;
        }

        .sound-wave span {
            width: 4px;
            height: 100%;
            background: var(--border-cream);
            border-radius: 4px;
            animation: wave 1.2s infinite ease-in-out;
        }

        .sound-wave span:nth-child(1) { animation-delay: 0.1s; }
        .sound-wave span:nth-child(2) { animation-delay: 0.3s; }
        .sound-wave span:nth-child(3) { animation-delay: 0.2s; }
        .sound-wave span:nth-child(4) { animation-delay: 0.4s; }

        /* Specifications Grid */
        .details-section {
            max-width: 1000px;
            margin: 5rem auto 3rem auto;
            padding: 0 1.5rem;
            text-align: left;
        }

        .details-card {
            background: var(--card-white);
            border-radius: 28px;
            padding: 3rem;
            border: 1px solid var(--border-cream);
            box-shadow: var(--shadow-cream);
            animation: fadeInUp 1.1s ease-out;
        }

        .details-card h3 {
            font-size: 1.8rem;
            color: var(--text-dark);
            margin-top: 0;
            border-bottom: 3px solid var(--accent-gold);
            padding-bottom: 0.8rem;
            display: inline-block;
        }

        .feature-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.8rem;
            margin: 2.5rem 0;
        }

        .feature-item {
            background: var(--bg-cream-soft);
            padding: 1.8rem;
            border-radius: 20px;
            border: 1px solid var(--border-cream);
            transition: all 0.3s ease;
        }

        .feature-item:hover {
            transform: translateY(-5px);
            border-color: var(--accent-gold);
            box-shadow: 0 10px 25px rgba(180, 83, 9, 0.08);
        }

        .feature-item h4 {
            margin: 0 0 0.5rem 0;
            color: var(--text-dark);
            font-size: 1.15rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .feature-item p {
            margin: 0;
            color: var(--text-muted);
            font-size: 0.95rem;
            line-height: 1.6;
        }

        /* Tech Specs Table */
        .spec-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 2rem;
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid var(--border-cream);
        }

        .spec-table th, .spec-table td {
            padding: 16px 20px;
            text-align: left;
        }

        .spec-table th {
            background: var(--text-dark);
            color: #ffffff;
            font-weight: 700;
        }

        .spec-table td {
            background: var(--card-white);
            color: #44403C;
            border-bottom: 1px solid var(--border-cream);
        }

        footer {
            background: var(--bg-cream-soft);
            color: var(--text-muted);
            padding: 3rem 1rem;
            text-align: center;
            margin-top: 6rem;
            border-top: 1px solid var(--border-cream);
        }

        footer p {
            margin: 0.5rem 0;
        }

        /* Animations */
        @keyframes pageFadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes slideDownNav {
            from { transform: translateY(-100%); }
            to { transform: translateY(0); }
        }

        @keyframes heroTextReveal {
            from { transform: translateY(30px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        @keyframes float3D {
            0% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-15px) rotate(1deg); }
            100% { transform: translateY(0px) rotate(0deg); }
        }

        @keyframes tagFloat {
            0% { transform: translateY(0px); }
            100% { transform: translateY(-8px); }
        }

        @keyframes glowPulse {
            0% { opacity: 0.5; transform: translate(-50%, -50%) scale(0.95); }
            100% { opacity: 0.9; transform: translate(-50%, -50%) scale(1.1); }
        }

        @keyframes badgePulse {
            0%, 100% { border-color: var(--border-cream); }
            50% { border-color: var(--accent-gold); }
        }

        @keyframes wave {
            0%, 100% { height: 6px; }
            50% { height: 18px; }
        }

        @keyframes ping {
            75%, 100% { transform: scale(2); opacity: 0; }
        }

        @keyframes cardPop {
            from { transform: scale(0.9); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @keyframes fadeInUp {
            from { transform: translateY(40px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        @keyframes lightShine {
            0% { transform: translateX(-100%) rotate(45deg); }
            20%, 100% { transform: translateX(100%) rotate(45deg); }
        }
    </style>
</head>

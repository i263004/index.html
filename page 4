<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us - Wireless Earbuds</title>
    <style>
        :root {
            --bg-cream: #FFFDF9;
            --bg-cream-soft: #FDFBF7;
            --card-white: #FFFFFF;
            --border-cream: #F1ECE1;
            --text-dark: #1C1917;
            --text-muted: #78716C;
            --accent-gold: #B45309;
            --shadow-cream: 0 20px 40px rgba(180, 83, 9, 0.06);
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: var(--bg-cream);
            color: var(--text-dark);
            margin: 0;
            padding: 0;
        }

        nav {
            background: rgba(255, 253, 249, 0.9);
            backdrop-filter: blur(16px);
            padding: 1.2rem 3rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border-cream);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            color: var(--text-dark);
            font-weight: 900;
            font-size: 1.4rem;
            letter-spacing: 2px;
        }

        .nav-links {
            display: flex;
            gap: 2rem;
        }

        nav a {
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 600;
        }

        nav a:hover, nav a.active {
            color: var(--text-dark);
        }

        .contact-wrapper {
            max-width: 650px;
            margin: 4rem auto;
            background: var(--card-white);
            padding: 3rem;
            border-radius: 28px;
            border: 1px solid var(--border-cream);
            box-shadow: var(--shadow-cream);
            animation: zoomIn 0.7s cubic-bezier(0.16, 1, 0.3, 1);
        }

        h2 {
            margin-top: 0;
            color: var(--text-dark);
            font-size: 2rem;
            letter-spacing: -0.5px;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        label {
            display: block;
            margin-bottom: 0.6rem;
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--text-dark);
        }

        input, textarea {
            width: 100%;
            padding: 1rem;
            border-radius: 14px;
            border: 1px solid var(--border-cream);
            background: var(--bg-cream-soft);
            color: var(--text-dark);
            box-sizing: border-box;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        input:focus, textarea:focus {
            outline: none;
            border-color: var(--accent-gold);
            background: #ffffff;
            box-shadow: 0 0 0 4px rgba(180, 83, 9, 0.1);
            transform: translateY(-2px);
        }

        button {
            width: 100%;
            padding: 1.1rem;
            background: var(--text-dark);
            color: #ffffff;
            border: 2px solid var(--text-dark);
            border-radius: 50px;
            font-size: 1.05rem;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.4s ease;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
        }

        button:hover {
            background: var(--bg-cream-soft);
            color: var(--text-dark);
            transform: translateY(-3px);
            box-shadow: 0 14px 35px rgba(0, 0, 0, 0.2);
        }

        .contact-info {
            margin-top: 2.5rem;
            padding-top: 1.8rem;
            border-top: 1px solid var(--border-cream);
            font-size: 0.98rem;
            color: var(--text-muted);
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
        }

        @keyframes zoomIn {
            from { transform: scale(0.9); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }
    </style>
</head>
<body>

    <nav>
        <div class="logo">AUDIO TECH</div>
        <div class="nav-links">
            <a href="PRODUCT.html">Home</a>
            <a href="features.html">Features</a>
            <a href="reviews.html">Reviews</a>
            <a href="contact.html" class="active">Contact</a>
        </div>
    </nav>

    <div class="contact-wrapper">
        <h2>Get in Touch</h2>
        <p style="color: var(--text-muted); margin-bottom: 2rem;">Have questions about your order or technical specifications?</p>

        <form action="#" method="post">
            <div class="form-group">
                <label>Full Name</label>
                <input type="text" placeholder="e.g. John Doe" required>
            </div>
            <div class="form-group">
                <label>Email Address</label>
                <input type="email" placeholder="earbuds@gmail.com" required>
            </div>
            <div class="form-group">
                <label>Message</label>
                <textarea rows="4" placeholder="How can we help you?" required></textarea>
            </div>
            <button type="submit">Send Message</button>
        </form>

        <div class="contact-info">
            <div><strong>📞 Direct Phone:</strong> +92 312 3456789</div>
            <div><strong>✉️ Support Email:</strong> support@earbuds.com</div>
        </div>
    </div>

</body>
</html>
